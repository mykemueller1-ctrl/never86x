# Never86 X — copy to .env.local. Never commit secrets.

# Auth (Missing until set). Magic-link session cookie. Do not commit a real value.
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
# ADMIN_EMAILS=you@example.com
# Bearer token for GET /api/admin/signups (CSV). Also accepts x-admin-email from ADMIN_EMAILS.
ADMIN_EXPORT_TOKEN=
# Transactional magic-link mail. No CRM contact is created.
RESEND_API_KEY=
# SEAT_FROM_EMAIL=Never86'd <login@never86.ai>
# Set to 1 only on a local machine to show the 6-digit code without email.
# SEAT_DEV_SHOW_CODE=
# Google is hidden inside X and when these are empty.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Postgres for seat_signups. Empty uses an in-memory store that resets on restart.
# SEAT_STORE=memory

# Stripe seats 2–3 (fail-closed if unset)
STRIPE_SECRET_KEY=
STRIPE_PRICE_SEAT2=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Observability
SENTRY_DSN=
NEXT_PUBLIC_SUPPORT_EMAIL=

# Data
DATABASE_URL=
